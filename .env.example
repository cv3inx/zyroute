# Copy to .env. See README.md for what each value does.
# Shell-exported vars win over this file (Node --env-file behaviour).

GATEWAY_API_KEYS=sk-zyroute-REPLACE_ME

AWS_BEARER_TOKEN_BEDROCK=ABSKxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

DEFAULT_MODEL=anthropic.claude-opus-4-7
DEFAULT_OPENAI_MODEL=openai.gpt-oss-120b-1:0

RATE_LIMIT_PER_MINUTE=120
MAX_BODY_MB=32
PORT=8787

# VPC endpoints instead of the region-derived hosts:
# BEDROCK_RUNTIME_URL=
# BEDROCK_CONTROL_URL=
# SYSTEM_PROMPT_FILE=./system-prompt.md
# NO_SAMPLING_MODELS=(fable-5|mythos-5|opus-5|opus-4-8|opus-4-7|sonnet-5)
# CACHE_POINT_MODELS=(anthropic\.|amazon\.nova)
# HOST=0.0.0.0
# LOG_BODIES=1
# PRETTY_JSON=0
# NO_COLOR=1
